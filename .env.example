# Optional configuration for `docker compose up` (see compose.yaml).
# Copy to .env and uncomment / fill in what you need. Everything is optional.

# Where the API listens inside the container. Nothing is published to the host;
# Traefik forwards to this port over the shared network (compose.local.yaml adds
# a host port when you want one).
PORT=8081

# Usage data: timesEaten, lastEaten, notes and the featured and frequency tags.
# A file: or http(s): URL. Unset means an empty log. For a CSV mounted into the
# container (see the commented `volumes` in compose.yaml):
# MEAL_LOG_CSV_URL=file:///data/meal-log.csv
#
# When the admin tracker below is configured, the database is the source of
# truth for usage and this CSV is ignored.

# --- Admin meal tracker (optional) -------------------------------------------
# With `DATABASE_URL` and all five OIDC / owner variables set, the API serves a
# signed-in page at /admin for logging what has been eaten, backed by Postgres.
# Leave any of them unset and those routes answer 503; the read-only API and the
# CSV fallback above are unaffected.
#
# The tracker UI itself lives in the frontend at /admin; its JavaScript calls
# the API's JSON endpoints with cookies. The frontend and API hosts must be
# same-site (they are: recibase.shed.gay and api.recibase.shed.gay share the
# registrable domain), so the `SameSite=Lax` session cookie is sent. For a
# frontend on a different site, move the cookie to SameSite=None (and keep
# `Secure`) or serve the API under the same domain.
#
# `docker compose` supplies a `db` service and a matching DATABASE_URL by
# default; override it to point at an external database.
# DATABASE_URL=postgres://recibase:recibase@db:5432/recibase
# POSTGRES_PASSWORD=recibase
#
# Generic OIDC discovery: the issuer's /.well-known/openid-configuration is
# read for the authorization/token/JWKS endpoints. `OIDC_REDIRECT_URL` is the
# absolute callback (usually https://<RECIBASE_API_HOST>/auth/callback) and must
# match what the provider has registered. `RECIBASE_OWNER_SUBJECT` is the one
# OIDC `sub` allowed to sign in.
# OIDC_ISSUER_URL=https://auth.example.com/application/o/recibase/
# OIDC_CLIENT_ID=recibase
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://api.recibase.shed.gay/auth/callback
# RECIBASE_OWNER_SUBJECT=
# Where the browser lands after login. Point it at the frontend's tracker so the
# UI (not the API's page) is shown; defaults to the API's own /admin.
# OIDC_POST_LOGIN_REDIRECT=https://recibase.shed.gay/admin
# The session cookie is `Secure` by default; set false only for plain-HTTP local
# development.
# SESSION_COOKIE_SECURE=true


# Recipe submission (POST /recipe-submissions). All four of these are required,
# or the route answers 503.
# RECIPE_SUBMIT_PASSCODE=
# GITHUB_TOKEN=
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAMES=example.com,www.example.com

# Optional overrides; these are the defaults.
# GITHUB_REPOSITORY=The-Silverwood-Institute/Recibase
# GITHUB_BASE_BRANCH=master

# The frontend (crates/frontend, the `frontend` service in compose.yaml).
# BACKEND_URL is handed to the browser in /manifest.json, so it must be an
# address the browser can reach, not just the compose network.
# BACKEND_URL=http://localhost:8081/

# Other Recibase deployments whose recipes the drawer lists alongside ours,
# labelled and linked to their site. `label|api|site`, several separated by `;`.
# Their recipes link out to `site/<permalink>`; a recipe we also have wins by
# name and shows an "also on" hint. Unset means no peers.
# PEER_BACKENDS=Kit & Alex|https://api.reciba.se/|https://reciba.se

# The deployed commit both images bake in at build time (`crates/core::Manifest`
# reports it as the manifest `version`; the frontend shows it in the footer).
# `docker compose build` forwards these as build arguments (a local `cargo build`
# reads the checkout instead); unset means both show `latest`. A CI usually has
# one of them, e.g. SOURCE_COMMIT=$GITHUB_SHA.
# SOURCE_COMMIT=
# GIT_COMMIT=
# GITHUB_SHA=

# Behind Traefik (compose.yaml carries the labels; delete them to run without).
# Two host names, because the frontend tells the browser the API's URL in
# /manifest.json and the browser calls it directly for the recipe search.
# RECIBASE_HOST=recibase.shed.gay
# RECIBASE_API_HOST=api.recibase.shed.gay
# TRAEFIK_CERTRESOLVER=myresolver
