{"name":"Simple Vegetarian Mexican","permalink":"vegetarian-mexican","edit":"https://github.com/The-Silverwood-Institute/Recibase/tree/master/src/main/scala/se/reciba/api/recibase/recipes/VegetarianMexican.scala","source":null,"description":"Low spoons vegetarian Mexican","tagline":null,"notes":[],"dated_notes":[],"tags":["Vegetarian","Low Effort","Stephani"],"inherited_tags":["Pescatarian","Vegetarian-ish"],"image":null,"ingredients_blocks":[{"name":null,"ingredients":[{"name":"Black Beans","quantity":"2 tins","prep":"drained","notes":null},{"name":"Frozen sweetcorn","quantity":"260g","prep":null,"notes":null},{"name":"Squash","quantity":"1","prep":null,"notes":null},{"name":"Garlic","quantity":null,"prep":"finely chopped","notes":null},{"name":"Cheese","quantity":null,"prep":null,"notes":"ideally Sainsbury's 4 cheese mix or a herb/spiced cheese"},{"name":"Tortillas","quantity":null,"prep":null,"notes":null},{"name":"Cinnamon","quantity":null,"prep":null,"notes":null},{"name":"Cumin","quantity":null,"prep":null,"notes":null},{"name":"Salt","quantity":null,"prep":null,"notes":null},{"name":"Soured Cream","quantity":null,"prep":null,"notes":"optional"}]}],"method":["Preheat the oven to 200°C (390°F, gas mark 6).","Peel the squash and chop into 2cm chunks.","Spread on a baking tray and mix with oil, cinnamon and cumin. Roast for 35 minutes.","Defrost the sweetcorn then combine in a large bowl with the black beans and garlic.","Once roasted, add the squash to the bowl along with the cheese. Taste and add salt or more spices.","Serve with tortillas"]}