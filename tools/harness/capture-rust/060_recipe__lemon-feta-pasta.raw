{"name":"Lemon Feta Pasta","permalink":"lemon-feta-pasta","edit":"https://github.com/The-Silverwood-Institute/Recibase/tree/master/src/main/scala/se/reciba/api/recibase/recipes/LemonFetaPasta.scala","source":null,"description":null,"tagline":null,"notes":[],"dated_notes":[],"tags":["Quick","Pescatarian","Low Effort","Scales"],"inherited_tags":[],"image":null,"ingredients_blocks":[{"name":null,"ingredients":[{"name":"Pine nuts","quantity":null,"prep":null,"notes":null},{"name":"Cashew nuts","quantity":null,"prep":null,"notes":null},{"name":"Brazil nuts","quantity":null,"prep":null,"notes":null},{"name":"Feta","quantity":"1 block, approx. 200g","prep":"cut into 1cm cubes","notes":null},{"name":"Tuna","quantity":"1 80g tin","prep":"drained","notes":"Optional"},{"name":"Olives","quantity":null,"prep":null,"notes":"Pimento or green preferred"},{"name":"Lemon juice","quantity":null,"prep":null,"notes":"Either fresh or bottled"},{"name":"Thyme","quantity":null,"prep":null,"notes":"Either fresh or dried"},{"name":"Fusilli","quantity":null,"prep":null,"notes":"Spaghetti also works well here"}]}],"method":["Boil water and cook the pasta until al dente or softer. Drain and set aside.","Meanwhile, add oil to a large, deep pan along with the pine, cashew and brazil nuts and roast over a high heat until brown.","Remove pan from the heat and allow to cool for a moment. Add half the feta to the pan and melt over a medium heat.","Add the tuna (if used), thyme, olives and lemon juice to the pan and warm.","Add the pasta and remaining feta and mix thoroughly.","Serve hot."]}