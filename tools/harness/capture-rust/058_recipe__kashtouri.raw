{"name":"Kashtouri","permalink":"kashtouri","edit":"https://github.com/The-Silverwood-Institute/Recibase/tree/master/src/main/scala/se/reciba/api/recibase/recipes/Kashtouri.scala","source":"Vegetarian Cookery Bible (2012: Reader's Digest)","description":"An Egyptian dish of rice, macaroni and lentils in a spicy tomato sauce.","tagline":null,"notes":[],"dated_notes":[],"tags":["Vegan","Scales","Hot Weather","Low Effort"],"inherited_tags":["Pescatarian","Vegetarian-ish","Vegetarian","Vegan-ish"],"image":null,"ingredients_blocks":[{"name":null,"ingredients":[{"name":"Risotto rice","quantity":"150g","prep":null,"notes":null},{"name":"Macaroni","quantity":"150g","prep":null,"notes":null},{"name":"Red lentils","quantity":"150g","prep":null,"notes":"Or 1 400g tin green lentils"},{"name":"Onion","quantity":"1","prep":"finely chopped","notes":null},{"name":"Garlic","quantity":null,"prep":"finely chopped or crushed","notes":null},{"name":"Chopped tomatoes","quantity":"1 400g tin","prep":null,"notes":null},{"name":"Cayenne pepper","quantity":"1-2 tsp","prep":null,"notes":null},{"name":"Ground coriander","quantity":"1 tsp","prep":null,"notes":null},{"name":"Lemon juice","quantity":null,"prep":null,"notes":null},{"name":"Salt","quantity":null,"prep":null,"notes":null},{"name":"Black pepper","quantity":null,"prep":null,"notes":null}]}],"method":["Bring water to a boil and fill a large saucepan. Add the rice and simmer for 5 minutes.","Add the macaroni and lentils and simmer for 10 minutes or until rice, macaroni and lentils are tender.","Drain and set aside.","Meanwhile, heat some oil in a large saucepan and cook onions and garlic until softened. Stir in cayenne pepper, coriander, chopped tomatoes and lemon juice. Add salt and pepper to taste.","Simmer for 5-10 minutes, stirring occasionally.","Add rice, macaroni and lentils to the mixture.","Serve hot."]}