{"name":"Lamb and Aubergine Daube","permalink":"lamb-aubergine-daube","edit":"https://github.com/The-Silverwood-Institute/Recibase/tree/master/src/main/scala/se/reciba/api/recibase/recipes/LambAubergineDaube.scala","source":"The Times - Dinner Tonight","description":null,"tagline":null,"notes":[],"dated_notes":[],"tags":["Spicy"],"inherited_tags":[],"image":null,"ingredients_blocks":[{"name":null,"ingredients":[{"name":"Aubergine","quantity":"350g","prep":null,"notes":null},{"name":"Onions","quantity":"2","prep":null,"notes":null},{"name":"Lamb Neck Fillet","quantity":"750g","prep":null,"notes":null},{"name":"Chopped Tomatoes","quantity":"1 400g tin","prep":null,"notes":null},{"name":"Chicken Stock","quantity":"250ml","prep":null,"notes":null},{"name":"Cumin Seed","quantity":"1/2 tsp","prep":null,"notes":null},{"name":"Fennel Seed","quantity":"1/2 tsp","prep":null,"notes":null},{"name":"Dried Chilli Flakes","quantity":"1/2 tsp","prep":null,"notes":null},{"name":"Ginger","quantity":"10g","prep":"peeled and grated","notes":null},{"name":"Olive Oil","quantity":null,"prep":null,"notes":null},{"name":"Cinamon Stick","quantity":null,"prep":null,"notes":null},{"name":"Salt","quantity":null,"prep":null,"notes":null},{"name":"Lemon","quantity":null,"prep":null,"notes":null}]}],"method":["Cut the aubergine into kebab sized chunks then immerse in water diluted with 2tbsp. Leave 20 for minutes. Rinse and drain.","Finely chop the onions. Pulverise the cumin, fennel, chilli flakes and ginger to make a corse paste.","Cut the lamb into kebab sized pieces.","Heat the oil in a large frying pan and stir fry the aubergine, tossing until beginning to soften but not completely cooked. Remove from the pan.","Add a dash more oil the cook the onions for 5 minutes, stirring frequently.","Stir in the cinnamon stick and spice paste.","Toss for a couple of minutes then push the onions to one side of the pan and brown the lamb.","Add the aubergine back along with the chopped tomatoes and stock.","Bring to a gentle simmer then cover and cook for 45 minutes or until lamb is tender.","Season with salt and lemon."]}