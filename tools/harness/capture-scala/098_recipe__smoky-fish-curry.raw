{"name":"Smoky fish and squash curry","permalink":"smoky-fish-curry","edit":"https://github.com/The-Silverwood-Institute/Recibase/tree/master/src/main/scala/se/reciba/api/recibase/recipes/SmokyFishSquashCurry.scala","source":null,"description":null,"tagline":null,"notes":[],"dated_notes":[],"tags":["Pescatarian","Spicy"],"inherited_tags":[],"image":null,"ingredients_blocks":[{"name":null,"ingredients":[{"name":"Onion","quantity":"1","prep":"diced","notes":null},{"name":"Garlic","quantity":"1 clove","prep":"finely chopped","notes":null},{"name":"Smoked fish","quantity":"200g","prep":"cut into bite-size pieces","notes":"Either haddock or basa"},{"name":"Coriander","quantity":"5g","prep":null,"notes":"Optional"},{"name":"Red chilli","quantity":"1","prep":"sliced","notes":"Replace with chilli flakes or powder"},{"name":"Creamed coconut","quantity":"50g","prep":null,"notes":"More is better"},{"name":"Ginger","quantity":"30g","prep":"finely chopped or grated","notes":"Use ground ginger for speed"},{"name":"Stock cube","quantity":"1","prep":null,"notes":null},{"name":"Ground coriander","quantity":"1 tsp","prep":null,"notes":null},{"name":"Ground turmeric","quantity":"1 tsp","prep":null,"notes":null},{"name":"Squash","quantity":"200g","prep":"peeled and cut into bite-size pieces","notes":"alternatively use sweet potato"},{"name":"Water","quantity":"350ml","prep":"boiling","notes":null},{"name":"Naan Bread","quantity":null,"prep":null,"notes":"Optional"}]}],"method":["Soften the onion in a pan.","Make the stock and add the creamed coconut.","Add the garlic, ginger, ground coriander, ground turmeric, chilli and the squash and mix well.","Pour in the stock and cook for 15-20 mins or until the squash is soft and the stock has thickened.","Add the smoked fish and cook for 5 mins or until cooked through.","Serve and garnish with corriander."]}