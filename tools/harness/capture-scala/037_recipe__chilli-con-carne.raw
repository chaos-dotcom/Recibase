{"name":"Chilli con Carne","permalink":"chilli-con-carne","edit":"https://github.com/The-Silverwood-Institute/Recibase/tree/master/src/main/scala/se/reciba/api/recibase/recipes/ChilliConCarne.scala","source":"Kit's Dad","description":null,"tagline":null,"notes":[],"dated_notes":[],"tags":["Vegetarian-ish","Freezes","Better Next Day","Scales","Spicy"],"inherited_tags":["Pescatarian"],"image":null,"ingredients_blocks":[{"name":null,"ingredients":[{"name":"Oil","quantity":null,"prep":null,"notes":null},{"name":"Salt","quantity":null,"prep":null,"notes":null},{"name":"Pepper","quantity":null,"prep":null,"notes":null},{"name":"Chilli Powder","quantity":"1 tsp","prep":null,"notes":null},{"name":"Crushed or whole dried chillies","quantity":"1 tsp","prep":null,"notes":null},{"name":"Red Pepper","quantity":"1","prep":null,"notes":null},{"name":"Frozen Sweetcorn","quantity":null,"prep":null,"notes":null},{"name":"Paprika","quantity":null,"prep":null,"notes":null},{"name":"Tomato Puree","quantity":null,"prep":null,"notes":null},{"name":"Peeled plum tomatoes","quantity":"1 400g tin","prep":null,"notes":null},{"name":"Italian Herbs","quantity":null,"prep":null,"notes":null},{"name":"Brown Sauce","quantity":null,"prep":null,"notes":null},{"name":"Beef stock cube or Bovril","quantity":null,"prep":null,"notes":null},{"name":"Rice","quantity":null,"prep":null,"notes":null},{"name":"Olive Oil","quantity":null,"prep":null,"notes":null},{"name":"Onion","quantity":"1","prep":null,"notes":null},{"name":"Garlic Clove","quantity":"1","prep":null,"notes":null},{"name":"Kidney Beans","quantity":"1 400g tin","prep":null,"notes":null},{"name":"Honey","quantity":"1 tbsp","prep":null,"notes":"Optional"},{"name":"Dark cooking chocolate","quantity":null,"prep":null,"notes":"Optional"},{"name":"Mince","quantity":"500g","prep":null,"notes":null}]}],"method":["Slice onions, crush garlic then brown in 2 tsp olive oil.","Add the pepper and cook for a minute.","Add the mince in batches and brown then stir in chilli powder and paprika.","Add the stock cube/Bovril dissolved in a small amount of water and stir.","Then add 2 inches or so of tomato purée and stir again, followed by the tinned tomatoes.","Simmer for half an hour then check for taste.","Add chilli powder or tomato purée depending on flavour, also salt/pepper if needed.","Stir in the sweetcorn.","A tablespoon of honey or a few pieces of dark chocolate can improve the flavour.","Serve with rice (preferably) or pasta."]}