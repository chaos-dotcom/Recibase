{"name":"Paneer Jalfrezi","permalink":"paneer-jalfrezi","edit":"https://github.com/The-Silverwood-Institute/Recibase/tree/master/src/main/scala/se/reciba/api/recibase/recipes/PaneerJalfrezi.scala","source":"Gousto","description":null,"tagline":null,"notes":[],"dated_notes":[],"tags":["Vegetarian","Quick","Spicy","Low Effort"],"inherited_tags":["Pescatarian","Vegetarian-ish"],"image":null,"ingredients_blocks":[{"name":null,"ingredients":[{"name":"Onion","quantity":"1","prep":"sliced","notes":null},{"name":"Green pepper","quantity":"1","prep":"sliced","notes":null},{"name":"Chilli flakes","quantity":"1/2 tsp","prep":null,"notes":null},{"name":"Ginger","quantity":"15g","prep":"finely chopped or grated","notes":null},{"name":"Paneer","quantity":"1 block (225g)","prep":"cut into bite-sized cubes","notes":null},{"name":"Garlic","quantity":"2-3 cloves","prep":"finely chopped or crushed","notes":null},{"name":"Salad Tomatoes","quantity":"2","prep":"chopped","notes":null},{"name":"Curry powder","quantity":"1 tbsp","prep":null,"notes":null},{"name":"Tomato purée","quantity":"32g","prep":null,"notes":null},{"name":"Brown sugar","quantity":"2 tsp","prep":null,"notes":null},{"name":"Stock cube","quantity":"1","prep":null,"notes":null},{"name":"Water","quantity":"300ml","prep":null,"notes":null}]}],"method":["Fry the paneer until brown, turning to achieve an even colouring then set aside.","Soften the onion in the pan with the sugar and a pich of salt until brown and starting to caramelise.","Add the sliced pepper and cook for 5-8 mins.","Disolve the stock cube in water.","Add the garlic, tomatoes, tomato purée, ginger, chilli flakes, curry poweder, stock and paneer to the pan and stir.","Cook for 5-10 mins on a medium heat until thickened."]}