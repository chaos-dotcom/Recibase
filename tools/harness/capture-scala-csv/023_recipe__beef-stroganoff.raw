{"name":"Beef Stroganoff","permalink":"beef-stroganoff","edit":"https://github.com/The-Silverwood-Institute/Recibase/tree/master/src/main/scala/se/reciba/api/recibase/recipes/BeefStroganoff.scala","source":"Kit's Dad","description":null,"tagline":null,"notes":[],"dated_notes":[{"date":"2022-05-16","note":"Add more cheese"}],"tags":["Scales","Slow"],"inherited_tags":[],"image":null,"ingredients_blocks":[{"name":null,"ingredients":[{"name":"Beef","quantity":"500g","prep":null,"notes":"Not casserole (too tough) or fillet (too expensive)"},{"name":"Garlic Clove","quantity":"1","prep":null,"notes":null},{"name":"Onion","quantity":"1","prep":null,"notes":null},{"name":"Mushrooms","quantity":"5-6","prep":null,"notes":null},{"name":"Soured Cream","quantity":"350ml","prep":null,"notes":null},{"name":"Beef or Pork Stock Cube","quantity":null,"prep":null,"notes":"Or 1 tbsp Bovril"},{"name":"Salt","quantity":"Pinch","prep":null,"notes":null},{"name":"Pepper","quantity":"Pinch","prep":null,"notes":null},{"name":"Paprika","quantity":"Pinch","prep":null,"notes":null},{"name":"Butter","quantity":"Wedge","prep":null,"notes":null}]}],"method":["Cover meat with clingfilm and hit with a rolling pin to flatten it.","Cut into thin strips and sprinkle with salt, pepper and paprika.","Slice mushrooms and place them to one side.","Slice the onion and crush the garlic then brown in melted butter.","Once softened take out and put on a plate to one side.","Brown the meat in batches then add the mushrooms and the Bovril or stock cube, diluted in a cup of hot water.","Put the onions back and add the soured cream then bring the mixture to just under boiling.","Simmer for 40 minutes then serve with rice or pasta, ideally rice."]}