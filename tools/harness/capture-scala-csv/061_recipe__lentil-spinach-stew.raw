{"name":"Lentil & Spinach Stew","permalink":"lentil-spinach-stew","edit":"https://github.com/The-Silverwood-Institute/Recibase/tree/master/src/main/scala/se/reciba/api/recibase/recipes/LentilSpinachStew.scala","source":"https://drive.google.com/file/d/1f247M9Y9DLk4T6NzMng1B6GRvhoaAX74C28UTyxk_Jo/view","description":null,"tagline":null,"notes":[],"dated_notes":[],"tags":["Vegan","Scales"],"inherited_tags":["Pescatarian","Vegetarian-ish","Vegetarian","Vegan-ish"],"image":null,"ingredients_blocks":[{"name":null,"ingredients":[{"name":"Garlic","quantity":"1 clove","prep":"diced","notes":null},{"name":"Onion","quantity":"1","prep":"roughly chopped","notes":null},{"name":"Carrots","quantity":"2-3","prep":"chopped","notes":null},{"name":"Salad Tomatoes","quantity":null,"prep":"chopped","notes":null},{"name":"Cream of coconut","quantity":null,"prep":"grated","notes":null},{"name":"Frozen Spinach","quantity":null,"prep":null,"notes":null},{"name":"Lentils","quantity":"150g","prep":null,"notes":null},{"name":"Water","quantity":"400ml","prep":null,"notes":null},{"name":"Worcestershire Sauce","quantity":null,"prep":null,"notes":null},{"name":"Stock cube","quantity":"1","prep":null,"notes":null},{"name":"Honey","quantity":null,"prep":null,"notes":null},{"name":"Chili flakes","quantity":null,"prep":null,"notes":null},{"name":"Cinnamon","quantity":null,"prep":null,"notes":null},{"name":"Nutmeg","quantity":null,"prep":null,"notes":null},{"name":"Olive Oil","quantity":null,"prep":null,"notes":null}]}],"method":["Put out frozen spinach so it can defrost.","Boil the kettle and make stock.","Heat the olive oil in a pan and cook the carrots and garlic with a little bit of honey for a few minutes.","Add the onions and cook for a few more minutes.","Add the tomatoes, stock, grated cream of coconut, a dash of Worcestershire sauce and the spices.","Bring to simmer then add the lentils. You’ll need to possibly add a bit of water as the lentils simmer.","Simmer with the lid on for however long lentils take (15-20 minutes?).","Add frozen spinach."]}